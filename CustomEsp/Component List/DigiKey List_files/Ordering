.dk-checkbox--toggle__shipping .dk-checkbox--toggle {
    position: absolute;
    visibility: hidden;
}

    .dk-checkbox--toggle__shipping .dk-checkbox--toggle ~ label {
        position: relative;
    }

        .dk-checkbox--toggle__shipping .dk-checkbox--toggle ~ label:after {
            content: "";
            border-radius: 10px;
            height: 18px;
            width: 35px;
            background-color: #cccccc;
            display: inline-block;
            position: absolute;
            right: -40px;
            top: -3px;
            cursor: pointer;
        }

        .dk-checkbox--toggle__shipping .dk-checkbox--toggle ~ label:before {
            content: "";
            border-radius: 10px;
            height: 10px;
            width: 15px;
            background-color: white;
            display: inline-block;
            position: absolute;
            right: -25px;
            top: 1px;
            z-index: 1;
            cursor: pointer;
        }

.rtl .dk-checkbox--toggle__shipping .dk-checkbox--toggle ~ label:after {
    left: -40px;
    right: auto;
}

.rtl .dk-checkbox--toggle__shipping .dk-checkbox--toggle ~ label:before {
    left: -25px;
    right: auto;
}

.dk-checkbox--toggle__shipping .dk-checkbox--toggle:checked ~ label:after {
    background-color: #26196B;
}

.dk-checkbox--toggle__shipping .dk-checkbox--toggle:checked ~ label:before {
    right: -35px;
}

.rtl .dk-checkbox--toggle__shipping .dk-checkbox--toggle:checked ~ label:before {
    left: -35px;
    right: auto;
}

