/* ORDERING HEADER FROM SITECORE OVERRIDES to be put into style.css in sitecore */
.dk-ordering.weBeOrdering #header,
.dk-ordering.weBeOrdering #header * {
    white-space: normal;
    background: none;
    margin: 0px;
    padding: 0px;
    content: none;
    height: auto;
    width: auto;
    line-height: normal;
    min-width: auto;
    text-align: initial;
    background-image: none;
    box-sizing: border-box;
}

    .dk-ordering.weBeOrdering #header .done,
    .dk-ordering.weBeOrdering #header .done:hover {
        background-image: none;
    }

    .dk-ordering.weBeOrdering #header *:after,
    .dk-ordering.weBeOrdering #header *:before {
        content: none !important;
    }



    .dk-ordering.weBeOrdering #header .logo {
        display: none;
    }

.dk-ordering.weBeOrdering #header-tabs {
    display: block;
    width: 100%;
}

    .dk-ordering.weBeOrdering #header-tabs a {
        display: block;
        padding: 10px 16px;
        font-size: 13px;
        color: var(--text-color) !important;
        width: 100%;
        box-sizing: border-box;
        background: var(--bg-color--card);
        border: 1px solid var(--border-color--card);
        margin-bottom:10px;
    }

.rtl .dk-ordering.weBeOrdering #header-tabs a {
    text-align: right;
}

.dk-ordering.weBeOrdering #header-tabs :not(.done),
.dk-ordering.weBeOrdering #header-tabs a[data-name="log-in"],
.dk-ordering.weBeOrdering #header-tabs a[data-name="shopping-cart"] {
    display: none;
}

.dk-ordering.weBeOrdering #header-tabs a span.header-tabs-edit-link {
    display:inline-block;
    float:right;
}

    .rtl.dk-ordering.weBeOrdering #header-tabs a span.header-tabs-edit-link {
        float: left;
    }

    .dk-ordering.weBeOrdering #header-tabs a:hover span.header-tabs-edit-link {
        text-decoration:underline;
    }

.dk-ordering.weBeOrdering #header-tabs .current {
    font-weight: bold;
    background: rgb(201,201,201);
    background: -moz-linear-gradient(0deg, rgba(201,201,201,1) 0%, rgba(236,236,236,1) 100%);
    background: -webkit-linear-gradient(0deg, rgba(201,201,201,1) 0%, rgba(236,236,236,1) 100%);
    background: linear-gradient(0deg, rgba(201,201,201,1) 0%, rgba(236,236,236,1) 100%);
    filter: progid:DXImageTransform.Microsoft.gradient(startColorstr="#c9c9c9",endColorstr="#ececec",GradientType=1);
    cursor: default !important;
}

    .dk-ordering.weBeOrdering #header-tabs a:hover {
        text-decoration: none !important;
    }






