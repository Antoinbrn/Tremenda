function updatePackType(itemSequence, cRef) {
    var parts = [];
    var dropstring = [];
    $("#package-dropdown_" + itemSequence + " .dk-input option").each(function () {
        dropstring.push($(this).attr("data-text"));
    })
    var partnumber = $("#package-dropdown_" + itemSequence + " .dk-input")[0].value;
    var q1 = "";
    dropstring.forEach((element) => {
        if (element.includes(partnumber)) {
            q1 = element.substring(0, element.indexOf("|") - 1);
        }
    })
    var obj = { quantity: q1, partNumber: partnumber, cRef: cRef };
    parts.push(obj);

    $.ajax({
        url: "/ordering/shoppingcart/shoppingcart/UpdatePackageType",
        type: "POST",
        //contentType: 'application/json',
        data: { itemSeq: itemSequence, details: parts },
        success: function (data) {
            var returnObj = { successesExist: false, successIndices: "", failuresExist: false, errors: "", warnings: "" };
            var addedFrom = "manualEntry";
            let clickText = 'Change Packaging';
            if (data.BaseSuccess == true) {
                processAddPartsResponse(data, addedFrom, returnObj);

                if (!returnObj.failuresExist) {
                    refreshPage(addedFrom, returnObj);
                    $('.AddPart').val('');
                    $('#parts_0__quantity').focus();
                }
                else {
                    if (returnObj.successIndices != "") {
                        $.each(returnObj.successIndices.split('|'), function () {
                            //parts_0__quantity
                            $('#parts_' + this.toString() + '__quantity').val('');
                            $('#parts_' + this.toString() + '__partNumber').val('');
                            $('#parts_' + this.toString() + '__cRef').val('');
                        });
                        refreshParts(addedFrom, returnObj);
                    }

                    if (returnObj.errors.length > 0) {
                        refreshPage(addedFrom, returnObj);
                        errorModal(data.BaseStatusCode, data.BaseStatusCodeDesc, 'errors:' + returnObj.errors + '\n\n\nwarnings:' + returnObj.warnings)
                    }
                }
                GTMShoppingcartClick(clickText);
            }
            else {
                if (data.BaseRedirectUrl != "") {
                    window.location.replace(data.BaseRedirectUrl);
                }
                else {
                    errorModal(data.BaseStatusCode, data.BaseStatusCodeDesc, data.BaseErrorMessage);
                }
            }
        },
        error: function (xhr, textStatus, errorThrown) {
            genericErrorModal();
        }
    });
}

