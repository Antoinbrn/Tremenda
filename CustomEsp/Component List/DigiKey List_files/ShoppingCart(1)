function RemoveRowFromPartErrorTable(indexToRemove) {
    // Get the part number before removing the row for cache cleanup
    const row = $('#PartErrorTable_Row' + indexToRemove);
    const partNumber = row.find('[id*=_PartNumber]').attr('originalValue');

    // Remove from cache using composite key
    if (partNumber) {
        RemoveCachedPartErrorData(partNumber + '_' + indexToRemove);
    }

    // Remove whatever row they clicked to remove
    row.remove();

    const partErrorTableChildrenCount = $('#PartErrorTable tbody').children().length;
    // If the children count is 0 we no longer need to show the table
    if (partErrorTableChildrenCount == 0) {
        $('#PartErrorContainer').attr('hidden', '');
        // Empty the cache if theres no rows since there shouldn't be any data either
        ClearCachedPartErrorData();
    }
    else {
        UpdateRemainingPartErrorTableRowIndices(indexToRemove);
    }
}

function UpdateRemainingPartErrorTableRowIndices(removedIndex) {
    const rowsToUpdate = $('#PartErrorTable tbody tr').filter(function () {
        const rowIndex = Number.parseInt($(this).attr('rowIndex'), 10);
        return !Number.isNaN(rowIndex) && rowIndex > removedIndex;
    });

    // Update each row
    rowsToUpdate.each(function () {
        const currentIndex = Number.parseInt($(this).attr('rowIndex'), 10);
        const newIndex = currentIndex - 1;

        // Update cache with new index BEFORE updating the row
        const partNumber = $(this).find('[id*=_PartNumber]').attr('originalValue');
        const oldKey = partNumber + '_' + currentIndex;
        const newKey = partNumber + '_' + newIndex;

        const cachedData = GetCachedPartErrorData(oldKey);
        if (cachedData) {
            RemoveCachedPartErrorData(oldKey);
            CachePartErrorData(newKey, cachedData);
        }

        UpdatePartErrorRowIndex($(this), newIndex);
    });
}

function AssignIndexToPartErrorRows(partResults) {
    const rowsToUpdate = $('#PartErrorTable tbody tr').filter(function () {
        const rowIndex = Number.parseInt($(this).attr('rowIndex'), 10);
        return Number.isNaN(rowIndex);
    });

    let currentNumberOfRows = $('#PartErrorTable tbody tr').filter(function () {
        const rowIndex = Number.parseInt($(this).attr('rowIndex'), 10);
        return !Number.isNaN(rowIndex);
    }).length + 1;

    //grab all the failed parts from the part results
    const partsWithFailures = partResults.filter(function (partResult) {
        return partResult.ReturnValue != 1 
    });
    let failedPartResultCounter = 0;
    
    rowsToUpdate.each(function (i, rowBeingUpdated) {
        UpdatePartErrorRowIndex($(this), currentNumberOfRows);
        // cache the part result information matching the current rows part number if the part has a validpartoption or a packtypeupselloption
        // THIS REQUIRES THE PART ROWS TO BE SENT BACK IN THE SAME ORDER AS THE FAILED PARTS ARE SENT BACK IN THE PART RESULT
        const partNumber = $(rowBeingUpdated).find('[id*=_PartNumber]').attr('originalValue');
        if ((partNumber == partsWithFailures[failedPartResultCounter].detail.partNumber) && 
            ((partsWithFailures[failedPartResultCounter].ValidPartOptions != null && partsWithFailures[failedPartResultCounter].ValidPartOptions.length > 0) ||
            partsWithFailures[failedPartResultCounter].PackTypeUpsellOption != null)) {
            const cacheKey = partNumber + '_' + currentNumberOfRows;
            CachePartErrorData(cacheKey, partsWithFailures[failedPartResultCounter]);
        }
        failedPartResultCounter += 1;
        currentNumberOfRows += 1;
    });
}

function UpdatePartErrorRowIndex(currentRow, updatedIndex) {
    $(currentRow).attr('rowIndex', updatedIndex);
    $(currentRow).attr('id', 'PartErrorTable_Row' + updatedIndex);

    // Update the index column of the row
    const indexColumn = $(currentRow).find('[id*=PartErrorIndex]');
    indexColumn.attr('id', 'PartErrorIndex_' + updatedIndex);
    indexColumn.text(updatedIndex);

    // Update the removal column of the row
    const removalColumn = $(currentRow).find('[id*=PartErrorRemove]');
    removalColumn.attr('rowIndex', updatedIndex);
    removalColumn.attr('id', 'PartErrorRemove_' + updatedIndex);
}

function PartErrorRowInputChange(currentRow) {
    //grab the input fields
    const partNumberInput = $(currentRow).find('[id*=_PartNumber]');
    const quantityInput = $(currentRow).find('[id*=_Quantity]');
    const crefInput = $(currentRow).find('[id*=_Cref]');

    //grab the original values
    const originalPartNumberValue = $(partNumberInput).attr('originalValue');
    const originalQuantityValue = $(quantityInput).attr('originalValue');
    const originalCrefValue = $(crefInput).attr('originalValue');

    //grab the current values
    const currentPartNumberValue = $(partNumberInput).val();
    const currentQuantityValue = $(quantityInput).val();
    const currentCrefValue = $(crefInput).val();

    //Make sure Quantity is just numbers
    if (quantityInput && quantityInput[0]) {
        ValidateQty(quantityInput[0]);
    }
    
    //if any of the values do not match, hide the option message and display the add button if exists
    if (originalPartNumberValue != currentPartNumberValue
        || originalQuantityValue != currentQuantityValue
        || originalCrefValue != currentCrefValue) {
        $(currentRow).find('[id*=_ErrorMessage]').attr('hidden', '');
        $(currentRow).find('[id*=_AddButton]').removeAttr('hidden');
    }
    else {
        $(currentRow).find('[id*=_ErrorMessage]').removeAttr('hidden');
        $(currentRow).find('[id*=_AddButton]').attr('hidden', '');
    }
}

function PartErrorRowAddToCart(currentRow) {
    //grab the input fields
    const partNumberInput = $(currentRow).find('[id*=_PartNumber]');
    const quantityInput = $(currentRow).find('[id*=_Quantity]');
    const crefInput = $(currentRow).find('[id*=_Cref]');

    //grab the current values
    const currentPartNumberValue = $(partNumberInput).val();
    const currentQuantityValue = $(quantityInput).val();
    const currentCrefValue = $(crefInput).val();

    const currentRowIndex = $(currentRow).attr('rowIndex');
    if (currentPartNumberValue != null && currentPartNumberValue != '' && currentQuantityValue != null && currentQuantityValue != '') {
        PartErrorRowCallImportParts(currentQuantityValue, currentPartNumberValue, currentCrefValue, currentRowIndex, currentRow);
    }
}

function PartErrorRowCallImportParts(quantityValue, partNumberValue, cRefValue, rowIndex, row) {
    const addPartString = quantityValue + ',' + partNumberValue + ',' + cRefValue;
    const addedFrom = "updateErrorParts";
    $.ajax({
        url: "/ordering/shoppingcart/shoppingcart/ImportParts",
        type: "POST",
        data: { parts: addPartString },
        success: function (data) {
            const returnObj = { successesExist: false, successIndices: "", failuresExist: false, errors: "", warnings: "" };
            // Display error partial view if present
            if (data.errorPartialView) {
                InsertPartErrorRowAtSpecificIndex(data.errorPartialView, row, rowIndex, data.response.partResults)
            }
            else {
                processAddPartsResponse(data.response, addedFrom, returnObj);
                refreshPage(addedFrom, returnObj)
                RemoveRowFromPartErrorTable(rowIndex);
            }
        },
        error: function (xhr, textStatus, errorThrown) {
            genericErrorModal();
        }
    });
}

function InsertPartErrorRowAtSpecificIndex(newPartErrorRow, oldPartErrorRow, rowIndex, partResults) {
    let newPartErrorRowObject = $(newPartErrorRow);
    UpdatePartErrorRowIndex(newPartErrorRowObject, rowIndex);
    UpdateCacheInfoWhenInsertingRow(oldPartErrorRow, rowIndex, partResults);
    $(oldPartErrorRow).replaceWith(newPartErrorRowObject);
}

// Global cache to store AddDetailResponseMessage data for each part error row
const partErrorDataCache = new Map();

function CachePartErrorData(partNumberWithRow, addDetailResponseData) {
    partErrorDataCache.set(partNumberWithRow, addDetailResponseData);
}

function GetCachedPartErrorData(partNumberWithRow) {
    return partErrorDataCache.get(partNumberWithRow) || null;
}

function RemoveCachedPartErrorData(partNumberWithRow) {
    partErrorDataCache.delete(partNumberWithRow);
}

function ClearCachedPartErrorData() {
    partErrorDataCache.clear();
}

function UpdateCacheInfoWhenInsertingRow(oldPartErrorRow, rowIndex, partResults) {
    const oldPartNumber = $(oldPartErrorRow).find('[id*=_PartNumber]').attr('originalValue');
    const oldCacheKey = oldPartNumber + '_' + rowIndex;
    RemoveCachedPartErrorData(oldCacheKey);
    if (partResults.length == 1) {
        if (partResults[0].ReturnValue == 1) {
            return;
        }
        if ((partResults[0].ValidPartOptions != null && partResults[0].ValidPartOptions.length > 0) ||
            partResults[0].PackTypeUpsellOption != null) {
            const partNumber = partResults[0].detail.partNumber;
            const cacheKey = partNumber + '_' + rowIndex;
            CachePartErrorData(cacheKey, partResults[0]);
        }
    }
}

function GetPopupForError(viewOptionElement) {
    const row = $(viewOptionElement).closest('tr');
    const partNumber = row.find('[id*=_PartNumber]').attr('originalValue');
    const rowIndex = row.attr('rowIndex');

    // Create composite key with part number and row index
    const cacheKey = partNumber + '_' + rowIndex;

    // Retrieve the cached AddDetailResponseMessage
    const partResultData = GetCachedPartErrorData(cacheKey);

    if (!partResultData) {
        genericErrorModal();
        return;
    }

    let isPackTypeUpsellPopup = false;
    if (partResultData.PackTypeUpsellOption != null
        && ((partResultData.ValidPartOptions != null && partResultData.ValidPartOptions.length == 0) || partResultData.ValidPartOptions == null)) {
        isPackTypeUpsellPopup = true;
    }

    if (isPackTypeUpsellPopup) {
        PartErrorRowCallGetPackTypeUpsell(partResultData, rowIndex);
    }
    else {
        PartErrorRowCallGetSuggestions(partResultData, rowIndex, row);
    }
}

function PartErrorRowCallGetPackTypeUpsell(partResultData, rowIndex) {
    // Call existing GetPackTypeUpsell endpoint to render the popup
    $.ajax({
        url: '/ordering/shoppingcart/shoppingcart/GetPackTypeUpsell',
        type: 'POST', 
        data: { partResult: partResultData, isUpdate: false },
        success: function (returnData) {
            let cleanData = DOMPurify.sanitize(returnData, { USE_PROFILES: { html: true } });
            if (cleanData == true) {
                refreshPage('importParts', null);
            }
            else if (cleanData == false) {
                genericErrorModal();
            }
            else {
                createSuggestionsModal($($.parseHTML(cleanData)).filter('#isValueCalculator').val());
                SetUpErrorRowPackTypeUpsellPopup(cleanData, rowIndex);
                dk.modal("#dialog-suggestions").show();

            }
        },
        error: function (xhr, textStatus, errorThrown) {
            genericErrorModal();
        }
    });
}

function PartErrorRowCallGetSuggestions(partResultData, rowIndex, row) {
    let isMultipleCRefForPartModal = false;
    if (partResultData.ErrorCode == 21) {
        isMultipleCRefForPartModal = true;
    }
    // Call existing GetSuggestions endpoint to render the popup
    $.ajax({
        url: '/ordering/shoppingcart/shoppingcart/GetSuggestions',
        type: 'POST',
        data: { partResult: partResultData },
        success: function (returnData) {
            let cleanData = DOMPurify.sanitize(returnData);
            SetUpErrorRowPopUp(cleanData, partResultData, rowIndex, row, isMultipleCRefForPartModal);
            dk.modal("#dialog-suggestions").show();
        },
        error: function (xhr, textStatus, errorThrown) {
            genericErrorModal();
        }
    });
}

function SetUpErrorRowPopUp(data, partResult, rowIndex, row, isMultipleCRefForPartModal) {
    // Create the Modal Element
    createSuggestionsModal($($.parseHTML(data)).filter('#isValueCalculator').val());
    // Put the information in the popup
    $("#dialog-suggestions #contentholder")[0].innerHTML = data;
    $("#dialog-suggestions .dk-modal__title").text($('#popupTitle').val());

    // Set the close buttons to delete the modal
    if (isMultipleCRefForPartModal) {
        $("#dialog-suggestions span[data-button='secondary']").text($('#BasePopupSkipButtonText').val()).on("click", function () {
            let parts = [];
            $("#dialog-suggestions input:radio:checked").each(function () {
                const index = this.id.replace('suggestion', '');
                const obj = { quantity: $("#validOptions_" + index + "__quantity")[0].value, partNumber: $("#validOptions_" + index + "__partNumber")[0].value, cRef: '' }
                parts.push(obj);
            });

            if (parts.length <= 0) {
                return;
            }

            const addedFrom = "ImportParts";
            //make the call to the add parts endpoint so we can override customer ref lookup
            $.ajax({
                url: "/ordering/shoppingcart/shoppingcart/AddParts",
                type: "POST",
                data: { details: parts, overrideUpsell: false, overrideCustRefLookup: true },
                success: function (data) {
                    if (data.BaseSuccess) {
                        let returnObj = { successesExist: false, successIndices: "", failuresExist: false, errors: "", warnings: "" };
                        processAddPartsResponse(data, addedFrom, returnObj);
                        if (!returnObj.failuresExist) {
                            refreshPage("manualEntry", returnObj); 
                        }
                        RemoveRowFromPartErrorTable(rowIndex);
                    }
                    else {
                        errorModal(data.BaseStatusCode, data.BaseStatusCodeDesc, data.BaseErrorMessage);
                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                    genericErrorModal();
                }
            });
            clearSuggestionsModal()

        });
    }
    else {
        $("#dialog-suggestions span[data-button='secondary']").text($('#BasePopupCancelButtonText').val()).on("click", function () {
            clearSuggestionsModal()
        });
    }

    
    $("#dialog-suggestions span[data-button='close'], #auto-modal-mask").on("click", function () {
        clearSuggestionsModal()
    });

    // set up the primary button
    $("#dialog-suggestions span[data-button='primary']").text($('#BasePopupAddButtonText').val()).on("click", function () {
        let parts = [];
        $("#dialog-suggestions input:radio:checked").each(function () {
            const index = this.id.replace('suggestion', '');
            let obj;
            if (index == "rdoNewRef") {
                obj = { quantity: $("#originalRequestedPart_quantity")[0].value, partNumber: $("#originalRequestedPart_partNumber")[0].value, cRef: $("#txtNewRef")[0].value }
            }
            else {
                obj = { quantity: $("#validOptions_" + index + "__quantity")[0].value, partNumber: $("#validOptions_" + index + "__partNumber")[0].value, cRef: $("#validOptions_" + index + "__cRef")[0].value }
            }
            parts.push(obj);
        });

        if (parts.length > 0) {

            PartErrorRowCallImportParts(parts[0].quantity, parts[0].partNumber, parts[0].cRef, rowIndex, row) 
        }
        clearSuggestionsModal()
    });
    
    if (partResult.ErrorCode == 26) {
        $("#radio").hide();
        $("#radioColumn").hide();
    }
    if (partResult.ErrorCode == 27) {
        $("#purchaselb").removeClass("hidden");
        $("#validOptionslb").hide();
        $("#radio").hide();
        $("#radioColumn").hide();
    }

    // auto check first button
    $("#dialog-suggestions input:radio:first").attr('checked', true);
}

function SetUpErrorRowPackTypeUpsellPopup(data, rowIndex) {
    const chkDisableValueCalc = "<div class='disableValueCalcDiv dk-checkbox-group' id='disableValueCalcDiv'><input id='disableValueCalc' class='dk-checkbox' type='checkbox' onclick='showHideUpsellSubOptions();' /><label class='dk-checkbox-label' for='disableValueCalc'>" + $('#DisableValueCalcText').val() + "</label></div>"
    $("#dialog-suggestions #contentholder")[0].innerHTML = data;
    $("#dialog-suggestions span[data-button='primary']").text($('#BasePopupAddButtonText').val()).on("click", function () {
        AddPackTypeUpsellToCart(this, false);
        RemoveRowFromPartErrorTable(rowIndex);
        clearSuggestionsModal()
    });

    $("#dialog-suggestions span[data-button='secondary']").text($('#BasePopupCancelButtonText').val()).on("click", function () {
        clearSuggestionsModal()
    });

    $("#dialog-suggestions span[data-button='close'], #auto-modal-mask").on("click", function () {
        // close function
        $("#disableValueCalc").attr('checked', false);
        $('#disableValueCalcDiv').remove();
        clearSuggestionsModal()
    });

    // add 'disable value calculator' checkbox next to buttons
    if (!($("#dialog-suggestions").parent().find(".disableValueCalcDiv").length) && ($('#valueCalcDisabled').val().toLowerCase() == 'false') && ($('#hasUpsell').val().toLowerCase() == 'true')) {
        $("#dialog-suggestions").parent().find(".dk-modal__footer").append(chkDisableValueCalc);
    }

    $("input:radio[id='suggestion1']").on("click", function () {
        $("input:radio[name='subOptions']").removeAttr("checked");
        $("input:radio[name='subOptions']").attr("disabled", "true");
    });

    $("input:radio[id='suggestion0']").change(function () {
        if (this.checked) {
            $("input:radio[name='subOptions']").removeAttr("disabled");
            $("input:radio[name='subOptions']").first().prop("checked", true);
        }
    });

    $("#dialog-suggestions .dk-modal__title").text($('#popupTitle').val());
    $("input:radio[name='suggestions']").first().prop("checked", true);

    if ($("#originalRequestedPartIsDkr").val() == "True") {
        $("#suggestion01").prop("checked", true);
    }
    else {
        $("input:radio[name='subOptions']").first().prop("checked", true);
    }
}

function getPartResultsAndCallAssignIndexToPartErrorRows(data) {
    // ImportParts can create a new cart if there is no cart or it can add to an existing cart, so we need to check for both situations
    // When creating a new cart we use data.response.DetailResponses.partResults
    // When adding to an existing cart it is data.response.partResults
    const partResults = data.response.partResults ||
        (data.response.DetailResponses && data.response.DetailResponses.partResults);
    if (partResults) {
        AssignIndexToPartErrorRows(partResults);
    }
}
