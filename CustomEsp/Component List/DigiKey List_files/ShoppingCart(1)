function getLogisticsProviderModalFooter(modalType, buttons) {
    const okFooter =
        `<footer id="ilp-modal-footer" class="dk-modal__footer">
    <button class="dk-btn__primary" data-modal-dismiss="true" onclick="GTMShoppingcartClick('${buttons.OkClickText}')">${buttons.OkButtonText}</button>
        </footer>`;

    const continueFooter =
        `<footer id="ilp-modal-footer" class="dk-modal__footer">
	<button id="btn-ilp-continue" class="dk-btn__primary" type="button" onclick="redirectToLogisticsPartner('${buttons.ContinueClickText}')">${buttons.ContinueButtonText}</button>
	<button data-modal-dismiss="true" class="dk-btn__secondary" type="button" onclick="GTMShoppingcartClick('${buttons.CancelClickText}')">${buttons.CancelButtonText}</button>
</footer>`;

    if (modalType === "OK") {
        return okFooter;
    }
    else {
        return continueFooter;
    }
}

function updateLogisticsPartnerModalContent() {
    /* Don't call this endpoint unless order is ILP eligible.  */
    if ($("#IsIndiaLogisticsPartnerAllowed").val() === "True") {
        $.ajax({
            url: "/ordering/shoppingcart/shoppingcart/GetLogisticsPartnerModalAsync",
            type: "GET",
            success: function (callbackObject) {
                const modal = callbackObject.modal;
                if (modal === null) return;

                const modalFooter = getLogisticsProviderModalFooter(modal.ModalType, modal.Buttons);

                $("#ilp-modal-title").text(modal.Title);
                $("#ilp-modal-content").text(modal.Content);
                $("#ilp-modal-footer").replaceWith(modalFooter);
                $("#ilp-modal-x").attr("onclick", "GTMShoppingcartClick('" + modal.Buttons.XClickText + "');");
            },
            error: function (xhr, textStatus, errorThrown) {
                genericErrorModal();
            }
        });
    }
}

