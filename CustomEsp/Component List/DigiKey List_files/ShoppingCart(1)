function refreshPackTypeDropdowns() {
    const packtypedropdowns = [];
    $("div[id^='package-dropdown_'] .dk-input").each(function () {
        packtypedropdowns.push($(this)[0]);
    })

    packtypedropdowns.forEach((dropdown) => {
        for (let i = 0; i < dropdown.length; i++) {
            const optiontext = dropdown[i].text;
            dropdown[i].setAttribute("data-text", optiontext);
            if (optiontext.includes("(CT)")) {
                dropdown[i].setAttribute("data-packtype", optiontext.substring(optiontext.indexOf("|") + 2, optiontext.indexOf(")") + 1));
            }
            else {
                dropdown[i].setAttribute("data-packtype", optiontext.substring(optiontext.indexOf("|") + 2, optiontext.indexOf("(") - 1));
            }
            dropdown[i].text = dropdown[i].getAttribute("data-packtype");
        }
    })
}

