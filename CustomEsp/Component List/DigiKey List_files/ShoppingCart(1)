function createSuggestionsPopup(partResult, isUpdate, originalQuanElem) {
    var originalQty = $(originalQuanElem).data('val');
    var url = "/ordering/ShoppingCart/ShoppingCart/GetSuggestions";
    var itemSeq = partResult.detail.optionalItemSeq;
    $.ajax({
        url: url,
        type: 'POST',
        data: { partResult: partResult },
        success: function (returnData) {
            let cleanData = DOMPurify.sanitize(returnData, { USE_PROFILES: { html: true } });
            createSuggestionsModal($($.parseHTML(cleanData)).filter('#isValueCalculator').val());
            $("#dialog-suggestions #contentholder")[0].innerHTML = cleanData;
            $("#dialog-suggestions .dk-modal__title").text($('#popupTitle').val());
            if (partResult.ErrorCode == 25) {
                $("#dialog-suggestions span[data-button='primary']").text($('#BasePopupOkButtonText').val()).on("click", function () {
                    clearSuggestionsModal()
                });
                $("#dialog-suggestions span[data-button='secondary']").hide();
            }
            else {
                // update quantity via dialog
                if (isUpdate) {
                    //add the content and buttons
                    $("#dialog-suggestions span[data-button='primary']").text($('#BasePopupUpdateButtonText').val()).on("click", function () {
                        var qty = 0;
                        $("#dialog-suggestions input:radio:checked").each(function () {
                            var index = this.id.replace('suggestion', '');
                            qty = $("#validOptions_" + index + "__quantity")[0].value;
                        });

                        // get the quantity elem for the original attempted update and set it to qty
                        $('#qty' + itemSeq, parent.document).val(qty);
                        // call UpdateQty passing it the elem
                        updateQuantity($('#qty' + itemSeq)[0], false);

                        clearSuggestionsModal()
                    });
                    $("#dialog-suggestions span[data-button='secondary']").text($('#BasePopupCancelButtonText').val()).on("click", function () {
                        if (originalQuanElem != undefined) {
                            originalQuanElem.value = originalQty;
                            $(originalQuanElem).data('val', originalQty)
                        }
                        clearSuggestionsModal()
                    });
                    $("#dialog-suggestions span[data-button='close'], #auto-modal-mask").on("click", function () {
                        if (originalQuanElem != undefined) {
                            originalQuanElem.value = originalQty;
                            $(originalQuanElem).data('val', originalQty)
                        }
                        clearSuggestionsModal()
                    })
                }
                // add part via popup
                else {
                    $("#dialog-suggestions span[data-button='primary']").text($('#BasePopupAddButtonText').val()).on("click", function () {
                        var parts = [];
                        $("#dialog-suggestions input:radio:checked").each(function () {
                            var index = this.id.replace('suggestion', '');
                            var obj = { quantity: $("#validOptions_" + index + "__quantity")[0].value, partNumber: $("#validOptions_" + index + "__partNumber")[0].value, cRef: $("#validOptions_" + index + "__cRef")[0].value }
                            parts.push(obj);
                        });

                        if (parts.length > 0) {
                            var addedFrom = "manualEntry";
                            $.ajax({
                                url: "/ordering/shoppingcart/shoppingcart/AddParts",
                                type: "POST",
                                data: { details: parts, overrideUpsell: false },
                                success: function (data) {
                                    if (data.BaseSuccess == true) {
                                        var returnObj = { successesExist: false, successIndices: "", failuresExist: false, errors: "", warnings: "" };
                                        processAddPartsResponse(data, addedFrom, returnObj);
                                        if (!returnObj.failuresExist) {
                                            refreshPage(addedFrom, returnObj);
                                            $('.AddPart').val('');
                                        }
                                    }
                                    else {
                                        errorModal(data.BaseStatusCode, data.BaseStatusCodeDesc, data.BaseErrorMessage);
                                    }
                                },
                                error: function (xhr, textStatus, errorThrown) {
                                    genericErrorModal();
                                }
                            });
                        }
                        clearSuggestionsModal()
                    });
                    $("#dialog-suggestions span[data-button='secondary']").text($('#BasePopupCancelButtonText').val()).on("click", function () {
                        clearSuggestionsModal()
                    });
                }
                if (partResult.ErrorCode == 26) {
                    $("#radio").hide();
                    $("#radioColumn").hide();
                }
                if (partResult.ErrorCode == 27) {
                    $("#purchaselb").removeClass("hidden");
                    $("#validOptionslb").hide();
                    $("#radio").hide();
                    $("#radioColumn").hide();
                }
                $("#dialog-suggestions input:radio:first").attr('checked', true);
            }
            dk.modal("#dialog-suggestions").show();
        },
        error: function (req, status, error) {
            genericErrorModal();
        }
    });
}

