    for (let i = 0; i < dropdown.length; i++) {
        if (!dropdown[i].getAttribute("selected")) {
            var droptext = dropdown[i].getAttribute("data-text");
            dropdown[i].text = droptext.substring(0, droptext.lastIndexOf("("));
        }
    }
}

function refreshSummary() {
    var url = '/ordering/ShoppingCart/ShoppingCart/GetSummary';
    $.ajax({
        url: url,
        type: 'GET',
        success: function (returnData) {
            // Replace existing div HTML with new HTML
            let elements = $(returnData);

            $('#divSummaryBoxTable').replaceWith(elements.find('#divSummaryBoxTable'));

            if (elements.find("#WebID").val() !== "0") {
                $("#divWebAccessId").show();
                $("#web_id").html(elements.find("#WebID").val())
            }
            else {
                $("#divWebAccessId").hide()
            }
            if ($('#shipMethodDropdown') != undefined) {
                dk.dropdowns('#shipMethodDropdown');
            }
            showHideCartName();
            toggleIndiaLogisticsPartnerVisibility();
},
        error: function (req, status, error) {
            genericErrorModal();
        }
    });
}

function refreshCartTools() {
    var url = '/ordering/ShoppingCart/ShoppingCart/GetCartTools';
    $.ajax({
        url: url,
        type: 'GET',
        success: function (returnData) {
            var holders = $("div[id$='Holder']");
            $(holders).each(function () {
                var whichContent = this.id.split("Holder");
                var toolContent = $(returnData).find("#" + whichContent[0]);
                $(this).html(toolContent);
            });
            toggleIndiaLogisticsPartnerVisibility();
            $(".dataTable tbody tr:not(.detailRow)").remove(); //shouldnt be needed anymore 

            $('#divCartTools').replaceWith(null);
            const tableSelection = document.querySelector("#content");
            tableSelection.insertAdjacentHTML("beforeEnd", returnData);

            createDetailsDataTableForCart();
        },
        error: function (req, status, error) {
            genericErrorModal();
        }
    });
}

