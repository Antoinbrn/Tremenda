function tariffPriceAlignment() {
    var tariffRow = document.getElementsByClassName('cart-tariff_message');
    if (tariffRow.length > 0) {
        if (window.innerWidth > 1024) {
            var itemUnitPrice = document.getElementsByClassName('detailRow_unitPrice_th')[0];
            var itemExtendedPrice = document.getElementsByClassName('detailRow_extendedPrice_th')[0];

            var itemUnitPriceInnerWidth = itemUnitPrice.offsetWidth - 8;
            var itemExtendedPriceInnerWidth = itemExtendedPrice.offsetWidth - 32;

            for (let row of tariffRow) {
                row.querySelector('div:nth-of-type(3)').setAttribute('style', 'width: ' + itemUnitPriceInnerWidth + 'px');
                row.querySelector('div:nth-of-type(4)').setAttribute('style', 'width: ' + itemExtendedPriceInnerWidth + 'px');
            }
        }
        else {
            for (let row of tariffRow) {
                row.querySelector('div:nth-of-type(3)').setAttribute('style', 'width: auto');
                row.querySelector('div:nth-of-type(4)').setAttribute('style', 'width: auto');
            }
        }
    }
}

