            let dropdown = $("#shipMethodDropdown").html();
            dropdown = dropdown.replace('selected="selected"', '').replace('value="' + shipValue + '"', 'value="' + shipValue + '" selected="selected"');

            $('#divSummaryBoxTable').replaceWith($(returnData).find("#divSummaryBoxTable"));
            $('#shipMethodDropdown').html(dropdown);
