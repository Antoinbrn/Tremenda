                        // Update Original Part Qty
                        if (selectedPartId == originalPartId) {
                            var qty = $("#validOptions_" + selectedRadioId + "__quantity")[0].value;

                            // get the quantity elem for the original attempted update and set it to qty
                            $('#qty' + itemSeq, parent.document).val(qty);

                            if (originalPartQty == qty) {
                                GTMValueCalcAdd(modalTitle, "Original Quantity");
                            } else {
                                GTMValueCalcAdd(modalTitle, "Suggested Quantity");
                            }

                            updateQuantity($('#qty' + itemSeq)[0], true);
                            
                        }
                        else {
                            // Remove Original Part
                            var selected = [];
                            selected.push(itemSeq)
                            DeletePart(selected);

                            GTMValueCalcAdd(modalTitle, "Suggested Quantity");
                        }

                        if (subOptionsSelected || (selectedPartId != originalPartId)) {
                            // Add New Parts
                            AddPackTypeUpsellToCart(this, true, originalPartId, originalQty)
                        }
                        clearSuggestionsModal()
                    });
                    $("#dialog-suggestions span[data-button='secondary']").text($('#BasePopupCancelButtonText').val()).on("click", function () {
                        if (originalQuanElem != undefined) {
                            originalQuanElem.value = originalQty;
                            $(originalQuanElem).data('val', originalQty)
                        }
                        GTMValueCalcCancel(modalTitle);
                        clearSuggestionsModal()
                    });

                    $("#dialog-suggestions span[data-button='close'], #auto-modal-mask").on("click", function () {
                        // close function
                        if (originalQuanElem != undefined) {
                            originalQuanElem.value = originalQty;
                            $(originalQuanElem).data('val', originalQty)
                        }
                        GTMValueCalcCancel(modalTitle);
                        clearSuggestionsModal();
                    });
                }
                // add part via popup
                else {
                    //add the content and buttons
                    $("#dialog-suggestions span[data-button='primary']").text($('#BasePopupAddButtonText').val()).on("click", function () {

                        AddPackTypeUpsellToCart(this, false);

