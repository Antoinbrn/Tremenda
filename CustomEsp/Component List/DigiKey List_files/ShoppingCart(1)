function GetRowNumberOnView(seqNum) {
    var blankRowCount = 0;
    var nonBlankRowCount = 0;
    var rowCount = $(".trManualEntry").length;

    for (i = 0; i < rowCount; i++) {
        if ($('#parts_' + i + '__partNumber').val().trim() == '') {
            blankRowCount++;
        }
        else {
            nonBlankRowCount++;
        }

        if (nonBlankRowCount == seqNum + 1) {
            return seqNum + blankRowCount;
        }
    }
    return seqNum;
}

