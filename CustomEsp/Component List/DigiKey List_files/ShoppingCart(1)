function createPackTypeUpsellPopup(partResult, isUpdate, originalQuanElem) {
    var originalQty = $(originalQuanElem).data('val');
    var itemSeq = partResult.detail.optionalItemSeq;
    var originalPartId = partResult.detail.partId;
    var originalPartQty = partResult.detail.quantity;
    var url = "/ordering/ShoppingCart/ShoppingCart/GetPackTypeUpsell";
    var chkDisableValueCalc = "<div class='disableValueCalcDiv dk-checkbox-group' id='disableValueCalcDiv'><input id='disableValueCalc' class='dk-checkbox' type='checkbox' onclick='showHideUpsellSubOptions();' /><label class='dk-checkbox-label' for='disableValueCalc'>" + $('#DisableValueCalcText').val() + "</label></div>"

    var itemPackType = partResult.PackTypeUpsellOption.PackagingCase;
    var modalTitle = "";
    switch (itemPackType) {
        case 1:
            // Packaging Changed
            modalTitle = "Packaging Changed";
            break;
        case 2:
        case 3:
        case 4:
            // Quantity Unavailable
            modalTitle = "Quantity Unavailable";
            break;
        case 7:
        case 8:
        case 9:
        case 10:
            // VALUE CAL MODAL
            modalTitle = "Value Calculator";
            break;
        default:
            // NONE
            modalTitle = "";
            break;
    }

    $.ajax({
        url: url,
        type: 'POST',
        data: { partResult: partResult, isUpdate: isUpdate },
        success: function (returnData) {
            let cleanData = DOMPurify.sanitize(returnData, { USE_PROFILES: { html: true } });
            if (cleanData == true) {
                refreshPage('manualEntry', null);
                setUrlOrdering();
            }
            else if (cleanData == false) {
                genericErrorModal();
                setUrlOrdering();
            }
            else {
                createSuggestionsModal($($.parseHTML(cleanData)).filter('#isValueCalculator').val());
                GTMValueCalcModalOpen(modalTitle);
                setUrlOrdering();
                $("#dialog-suggestions #contentholder")[0].innerHTML = cleanData;

                if (isUpdate) {
                    //add the content and buttons
                    $("#dialog-suggestions span[data-button='primary']").text($('#BasePopupUpdateButtonText').val()).on("click", function () {
                        var subOptionsSelected = $("#dialog-suggestions input:radio[name='subOptions']:checked").val();
