function isValidUrl(url) {

    let parts = url.split('?');
    let path = parts[0];
    let query = parts[1] || '';

    // Allow only this endpoint 
    if (path !== '/ordering/ShoppingCart/ShoppingCart/ChangeCurrency') {
        return false;
    }

    let params = new URLSearchParams(query);

    // reprice must be  4 = RepriceReason.CurrencyChangeContinue
    if (params.get('reprice') !== '4') {
        return false;
    }

    // curr must be number (if present)
    if (params.has('curr') && !/^\d+$/.test(params.get('curr'))) {
        return false;
    }

    // newSite must be number (if present)
    if (params.has('newSite') && !/^\d+$/.test(params.get('newSite'))) {
        return false;
    }

    // block unknown params
    for (let key of params.keys()) {
        if (!['reprice', 'curr', 'newSite'].includes(key)) {
            return false;
        }
    }

    return true;
}


function repriceOrder(curr) {

    var redirect = true;
    var url = '/ordering/ShoppingCart/ShoppingCart/ChangeCurrency?reprice=4'; // 4 = RepriceReason.CurrencyChangeContinue
    if (curr != undefined && curr.length) {
        url += '&curr=' + curr;
        redirect = false;
    }
    if ($('#NewSiteCode').val() != undefined && $('#NewSiteCode').val() != '0') {
        url += '&newSite=' + $('#NewSiteCode').val();
    }

    if (!isValidUrl(url)) {
        setTimeout(() => {
           genericErrorModal("Invalid currency");
        }, 100);
       return;
    }

    $.ajax({
        url: url,
        type: 'GET',
        success: function (returnData) {
            if (redirect) {
                if (returnData.redirectUrl != "") {
                    window.location.href = returnData.redirectUrl;
                }
                else {
                    genericErrorModal();
                }
            }
            else {
                return;
            }
        },
        error: function (req, status, error) {
            genericErrorModal();
        }

    })
}

