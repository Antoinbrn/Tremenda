function UpdateShipMethod(shipValue) {

    let shipPrice = shipValue.split(':')[0];
    let shipMethod = shipValue.split(':')[1];
    let transitDays = shipValue.split(':')[2];
    let url = '/ordering/ShoppingCart/ShoppingCart/ShipMethodChanged';
    url = window.fixUrlForGuest(url);
    if (shipPrice == 0) {
        shipPrice = -1;
    }

    let selectedShipMethod =
    {
        "PrimaryShipMethod": shipMethod,
        "ShippingPrice": shipPrice,
        "ShipAssignmentMethodOptions": [{ "EstimatedTransitDays": transitDays }]
    }

    // Get Selections for each Ship Assignment
    let selectedShipMethods = [];
    selectedShipMethods.push(selectedShipMethod);

    $.ajax({
        url: url,
        type: 'POST',
        data: {
            shipAssignmentViewModels: selectedShipMethods
        },
        success: function (returnData) {
            //we want to save the dropdown, since it has all our shipping options in it. The one in returnData does not.
