/**
 * Handles the "Add to List" button click, collecting selected parts and creating/updating a list.
 * This function no longer validates for duplicate list names, as the myLists API now handles
 * duplicates automatically by appending a suffix (e.g., "(1)", "(2)").
 */
function addToListPost() {
    var partsForList = [];
    var items = [];
    $(".detailRow .dk-checkbox:checked").each(function () {
        var partNumber = $(this).parent().parent().parent().find(".cart-partNumber a").text();
        var quantity = $(this).parent().parent().parent().find(".part-quantity").val();
        var cref = $(this).parent().parent().parent().find(".customer-reference").val();
        var thisPart = { "requestedPartNumber": partNumber, "customerReference": cref, "quantities": [{ "quantity": Math.floor(quantity) }] };
        partsForList.push(thisPart);

        try {
            var tagValue = $(this).parent().parent().parent().find(".GTMDetailTag").val();
            var gtmTagValue = $.parseJSON(tagValue);
            items.push(gtmTagValue);
        }
        catch (e) {
            //dont let analytics break the page
        }
    })

    if ($("#newList:checked").length) {
        GTMAddToWishlist(items, "New List");

        var listName = $("#addToListInput").val();
        if (listName != "") {
            var url = "/ordering/ShoppingCart/ShoppingCart/AddPartsToNewList";
            var data = { listName: listName, requestedParts: partsForList }
            // Pass the requested list name as a fallback in case the API doesn't return the actual name
            addToListAjax(url, data, listName);
        } else {
            $("#addToListInput").addClass("dk-input--error");
            $("#addToListInput").on("keypress", function () { $("#addToListInput").removeClass("dk-input--error"); })
        }

    } else {
        GTMAddToWishlist(items, "Existing List");

        var listId = $("#addToListDropDown").val();
        var listName = $("#addToListDropDown option:selected").text();
        var url = "/ordering/ShoppingCart/ShoppingCart/AddPartsToExistingList";
        var data = { listId: listId, requestedParts: partsForList }
        addToListAjax(url, data, listName);
    }
}

/**
 * Makes an AJAX call to add parts to a list (new or existing).
 * For new lists, displays the actual list name returned by the API, which may differ from the requested name
 * if a duplicate list name was detected (e.g., "MyList" -> "MyList(1)").
 *
 * @param {string} url - The endpoint URL (AddPartsToNewList or AddPartsToExistingList)
 * @param {object} data - The request payload containing list information and parts
 * @param {string} listName - The fallback list name to display if the API doesn't return one
 */
function addToListAjax(url, data, listName) {
    $.ajax({
        url: url,
        type: 'post',
        data: data,
        datatype: 'json',
        success: function (data) {
            // Use the list name returned from the API if available, otherwise fall back to the provided listName
            // For new lists with duplicate names, the API returns the modified name (e.g., "MyList(1)")
            // For existing lists, the API doesn't return a ListName, so we use the fallback
            const displayListName = data.ListName || listName;
            $("#listLink").attr("href", "/" + __headerData.lang + "/mylists/list/" + data.ListId).text(displayListName);
            dk.modal("#dialog-add-to-list").hide();
            $("#addToListDropDown").html("");
            $("#addToListInput").val("");
            dk.modal("#dialog-add-to-list-success").show();
        },
        error: function (req, status, error) {
            dk.modal("#dialog-add-to-list").hide();
            $("#addToListDropDown").html("");
            $("#addToListInput").val("");
            genericerrormodal();
        }
    });
}

