function shareCopyToClipboard(elem) {

    const copyText = $(elem).prev('#CartShareURL').val();

    if (navigator.clipboard) {
        navigator.clipboard.writeText(copyText).then(() => {
            $('.copyToClipboard--callout:nth-of-type(1)').addClass('calloutHide');
            $('.copyToClipboard--callout:nth-of-type(2)').removeClass('calloutHide');
        });
    } else {
        // USE execCommand - Create the textarea element to copy from.
        const copyTextareaEl = document.createElement('textarea');
        copyTextareaEl.value = copyText;
        copyTextareaEl.setAttribute('readonly', '');
        copyTextareaEl.classList.add('copyTextArea');

        document.body.appendChild(copyTextareaEl);

        copyTextareaEl.select();
        document.execCommand('copy');

        document.body.removeChild(copyTextareaEl);
        $('.copyToClipboard--callout:nth-of-type(1)').addClass('calloutHide');
        $('.copyToClipboard--callout:nth-of-type(2)').removeClass('calloutHide');
    }

    $('.copyToClipboard--wrapper').on('mouseleave', function () {
        $('.copyToClipboard--callout:nth-of-type(1)').removeClass('calloutHide');
        $('.copyToClipboard--callout:nth-of-type(2)').addClass('calloutHide');
    });
}

