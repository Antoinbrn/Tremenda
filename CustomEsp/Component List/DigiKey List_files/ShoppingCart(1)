function GetGTMTagDetails(tagClass = '.GTMDetailTag', data = undefined) {
    var items = [];
    var indexx = 0;
    if (data === undefined) {
        var DetailTagElements = $(tagClass);
        $(DetailTagElements).each(function (index, element) {
            var tagValue = $(element).val();
            if ($(element).val()) {
                var detailTag = $.parseJSON(tagValue);
                items[indexx] = detailTag;
                indexx++;
            }
        });
    }
    else {
        $(data.partResults).each(function (index, element) {
            const detailTag = $.parseJSON(element.GTMDetailTag);

            //don't add parts that errored
            if (detailTag != undefined && !data.BaseRedirectUrl.includes(detailTag.item_sku)) {
                items[indexx] = detailTag;
                indexx++;
            }
        });
    }

    return items;
}

