function RemoveManualEntryRequiredValidation() {
    var customerId = $('#BaseCustomerID').val();
    var allBlank = true;

    $('.trManualEntry').each(function (tr) {
        var strQuantity = 'parts_' + tr + '__quantity';
        var strPartNumber = 'parts_' + tr + '__partNumber';
