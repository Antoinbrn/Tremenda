$(document).ready(function () {
    function scheduleRefreshAtSpecificTimes(times) {
        let now = new Date();
        let closestTimeDiff = Infinity;       

        // Find the next time to refresh
        for (let time of times) {
            let [hour, minute] = time;
            let currentDate = new Date();
            let targetDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), currentDate.getDate(),
                hour, minute, 0, 0);

            //If the time is already past today, set it to tomorrow
            if (targetDate < now) {
                targetDate.setDate(targetDate.getDate() + 1);
            }

            let timeDiff = targetDate - now;
            if (timeDiff < closestTimeDiff) {
                closestTimeDiff = timeDiff;
            }
        }

        // Wait for the calculated time and then refresh the page
        setTimeout(function () {
            location.reload();
        }, closestTimeDiff);
    }

    let startOfBusinessHour = new Date($("#StartOfBusinessUtc").val()).getHours();
    let endOfBusinessHour = new Date($("#EndOfBusinessUtc").val()).getHours();

    // Define your specific times (24-hour format)
    let specificTimes = [[startOfBusinessHour, 0], [endOfBusinessHour, 0]];

    // Schedule refreshes at the defined times
    scheduleRefreshAtSpecificTimes(specificTimes);
    runCountdownTimers()
});

function runCountdownTimers() {

    if ($("#FlagShowOffsiteWarningOnly").val() === 'True') {
        $("#divOffsiteInvExpiredWarning").removeClass("hidden");
        return; // No countdown timers to run
    }
    // Hide the warning message if it was previously shown
    $("#divOffsiteInvExpiredWarning").addClass("hidden");

    let items = $('[id^="offsite-inv-countdown"]');
    for (let item of items) {
        let itemId = item.id.replace("offsite-inv-countdown", "");
        runTimer(itemId);
    };
}

function runTimer(itemNumber) {
    let x = setInterval(function () {
        try {
            let nowString = new Date().toUTCString();
            let now = Date.parse(nowString);
            let dateString = $("#Details_" + (itemNumber - 1) + "__TimeToOrderBy").val();
            let timeStamp = Date.parse(dateString + " GMT");
            let distance = new Date(timeStamp) - now;
            let hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            let minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            let seconds = Math.floor((distance % (1000 * 60)) / 1000);

            $("#offsite-inv-countdown" + itemNumber + " .countDownTimer").html("<span class='bold'>" + hours.toString().padStart(2, "0") + ":" + minutes.toString().padStart(2, "0") + ":" + seconds.toString().padStart(2, "0") + "</span>");

            // If the count down is finished display expired message
            if (distance < 0) {
                clearInterval(x);
                $("#offsite-inv-countdown" + itemNumber).addClass("hidden");
                $("#offsite-inv-expired" + itemNumber).removeClass("hidden");
                $("#divOffsiteInvExpiredWarning").removeClass("hidden");
            }
            else {
                $("#offsite-inv-countdown" + itemNumber).removeClass("hidden");
            }
        }
        catch {

        }
       
    }, 1000);
};
