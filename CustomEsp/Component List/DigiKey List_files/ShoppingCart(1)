        var img = $(this).parent().parent().parent().find(".cart-image img").attr("src");
        var cref = $(this).parent().parent().parent().find(".cart-customerReference input").val();
        var qty = $(this).parent().parent().parent().find(".cart-qtyInput input").val();

        var configPart = $(this).parent().parent().parent().find(".FlagConfig").val();
        var existInSavedList =
            JSON.stringify(savedParts).indexOf(dkpn) !== -1
            || JSON.stringify(newSavedParts).indexOf(dkpn) !== -1;

        if (configPart == "True") {
            //skip this one and add to config list for customer to remove or keep
            configParts.push({
                DkPartNumber: $(this).parent().parent().parent().find(".cart-partNumber span").text(),
                ManufacturerPartNumber: mfpn,
                ManufacturerName: mfname,
                Description: desc,
                ImageUrl: img
            });
        }
        else if (!existInSavedList){
            var newSavedPart = {
                dkpn: dkpn,
                dklink: dklink,
                mfpn: mfpn,
                mfname: mfname,
                desc: desc,
                img: img,
                qty: qty,
                cref: cref
            };
            newSavedParts.push(newSavedPart);
        }
    }).promise().done(function () {
        if (configParts.length > 0)
            ConfigurablePartSaveForLaterRemoval(configParts, newSavedParts);
        else
            SaveAndRemoveSaveForLaterParts(newSavedParts);
    });
}

function SaveAndRemoveSaveForLaterParts(newSavedParts = [], removeConfig = false) {
    var selected = [];
    //if S4L and remove config = delete
    //if S4L and No remove config = remove all but config
    $("#cartDetails input:checkbox:checked").each(function () {
        var flagConfig = $(this).parent().parent().find(".FlagConfig").val();
        var configPart = false;
        if (flagConfig != undefined) {
            configPart = "True" == flagConfig;
        }

        if ($(this).attr('class') != 'chkSelectAll dk-checkbox'
            && (removeConfig || (!removeConfig && !configPart)))
        {
            selected.push($(this).attr('id').replace('chkDelete', ''));
        }
    });

    //saves only savable parts and updates saved list
    if (newSavedParts.length > 0) {
        savedParts = savedParts.concat(newSavedParts);
        localStorage.setItem("savedParts", JSON.stringify(savedParts));
        newSavedParts.forEach(renderSavedParts);
    }
    //deletes savable and non savable parts
    if (selected.length > 0) {
        DeletePart(selected, "SavedForLater");
    }
}

function ConfigurablePartSaveForLaterRemoval(configPartList = [], newSavedParts = []) {
    //populate pop up with config list is length > 0
    if (configPartList.length > 0) {
        var url = "/ordering/ShoppingCart/ShoppingCart/GetConfigSaveForLaterList";
        $.ajax({
            url: url,
            type: 'POST',
            data: { configList: configPartList},
            success: function (returnData) {
                var cleanData = DOMPurify.sanitize(returnData, { USE_PROFILES: { html: true } });
                CreateSaveForLaterErrorModal();

                $("#dialog-save-for-later-error #contentholder")[0].innerHTML = cleanData;
                $("#dialog-save-for-later-error .dk-modal__title").text($('#PopupTitle').val());

                $("#dialog-save-for-later-error span[data-button='secondary']").text($('#BasePopupRemoveButtonText').val()).on("click", function () {
                    //remove config and S4L parts
                    ClearSaveForLaterErrorModal();
                    SaveAndRemoveSaveForLaterParts(newSavedParts, true);

                });
                $("#dialog-save-for-later-error span[data-button='primary']").text($('#BasePopupLeaveButtonText').val()).on("click", function () {
                    //keep config parts and remove S4L parts
                    ClearSaveForLaterErrorModal();
                    SaveAndRemoveSaveForLaterParts(newSavedParts);
                });

                dk.modal("#dialog-save-for-later-error").show();
            },
            error: function (req, status, error) {
                genericErrorModal();
            }
        });
    }
    else {
        //no config parts just remove parts and save
        SaveAndRemoveSaveForLaterParts(newSavedParts);
    }
}

