        if ($.trim(mailStop.val()) == "" && $.trim(addressLine1.val()) == "" && $.trim(addressLine2.val()) == "") {
            AddRequiredValidator(addressType + 'Address_MailStop');
            AddRequiredValidator(addressType + 'Address_AddressLine1');
            AddRequiredValidator(addressType + 'Address_AddressLine2');
        }
        else {
            RemoveRequiredValidator(addressType + 'Address_MailStop');
            RemoveRequiredValidator(addressType + 'Address_AddressLine1');
            RemoveRequiredValidator(addressType + 'Address_AddressLine2');
        }
    }
}

