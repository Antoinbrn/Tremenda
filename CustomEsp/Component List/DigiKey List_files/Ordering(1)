function GTMShoppingcartClick(clickText, eventState) {
    var gtmValue;
    if (eventState) {
        gtmValue = {
            'event': 'shopping_cart_click',
            'click_text': clickText,
            'event_state': eventState,
        }
    }
    else {
        gtmValue = {
            'event': 'shopping_cart_click',
            'click_text': clickText,
        }
    }
    if (dataLayer !== undefined && dataLayer.push !== undefined) {
        dataLayer.push({ ecommerce: null }); // Clear previous ecommerce object
        dataLayer.push(gtmValue);
    }
}

async function deletePromotion() {
    let url = "/ordering/Shared/Shared/DeletePromotion";
    let reloadWithSpinner = false;
    await $.ajax({
        url: url,
        type: 'POST',
        dataType: 'json',
        success: function (data) {
            if (data === true) {
                reloadWithSpinner = true;
            }
            else {
                dk.modal('#dialog-error-promotion').show();
            }
        },
        error: function (req, status, error) {
            genericErrorModal();
        }
    });
    if (reloadWithSpinner) {
        startSpinner();
        // Takes base of URL (www.digikey.xx/ordering) and appends path (/shopping as example) without query params
        let cartUrl = new URL(window.location.pathname, window.location.href)
        window.location.replace(cartUrl.href);
    }
};
