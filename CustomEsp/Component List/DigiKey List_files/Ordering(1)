// Set the label width to the widest label plus padding
function setLabelWidth(labelClass) {
    $("." + labelClass + ":visible").css('display', 'inline');

    var widestWidth = 0;
    $("." + labelClass + ":visible").each(function () {

        var text = $(this).html();
        $(this).html('<span>' + text + '</span>');
        var width = $(this).find('span:first').width();
        $(this).html(text);

        if ($(this).hasClass("required")) {
            width += 11  // Account for the asterisk
        }

        if (width > widestWidth) {
            widestWidth = width;
        }
    });

    $("." + labelClass + ":visible").css('display', '');
    $('head').append("<style> ." + labelClass + " { width:" + widestWidth + "px }</style>");
}

// Generic Error Dialog to be resued everywhere
function genericErrorDialog(message) {
    if (message === undefined) {
        message = "";
    }
    if (message.length > 0) {
        $("#errorMessage").html(message);
    }
    else {
        $("#errorMessage").html($('#BasePopupGenericErrorDialog').val());
    }
    $("#errorDialog").dialog(
        {
            dialogClass: "no-close-button",
            title: $('#BasePopupGenericErrorTitle').val(),
            buttons: [
                {
                    text: $('#BasePopupOkButtonText').val(),
                    click: function () {
                        $(this).dialog("close");
                    }
                }
            ]
        }
    );
}

function genericErrorModal(message) {
    if (message === undefined) {
