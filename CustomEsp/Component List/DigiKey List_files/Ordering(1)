function addDays(date, days) {
    var result = new Date(date);
    result.setDate(date.getDate() + days);
    return result;
}

function getDatePickerDefaultDate(dateFromEnUS) {
    var result = new Date(dateFromEnUS);
    if (result.getDay() === 6) {
        //Sets day to next Monday if Saturday
        result = addDays(result, 2);
    }
    else if (result.getDay() === 0) {
        //Sets day to next Monday if Sunday
        result = addDays(result, 1);
    }
    return result;
}

