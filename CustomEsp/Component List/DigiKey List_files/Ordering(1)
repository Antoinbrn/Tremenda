function AddRequiredValidator(id) {
    $('#' + id).rules('add', 'required');
    $('#' + id).attr('required', true);
    $("label[for='" + id + "']").removeClass('notRequired').addClass('required');
}

function RemoveRequiredValidator(id) {
    let $element = $('#' + id);

    // Check if element exists and has validation initialized
    if ($element.length && $element.closest('form').data('validator')) {
        $element.removeAttr('required');
        $element.rules('remove', 'required');
        $('#' + id + '-error').hide();
        $element.addClass("valid");
        $element.removeClass("input-validation-error");
    }

    $("label[for='" + id + "']").removeClass('required').addClass('notRequired');
}


