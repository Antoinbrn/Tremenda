//jQuery Dialog
function showHelpDialog(data) {
    var dlg = $(data);
    var btns = {};
    btns[dlg.attr("close")] = function () { $(this).dialog("close"); };
    dlg.addClass("helpPopup");
    var dialogMaxHeight = window.innerHeight - 25;

    dlg.dialog({
        resizable: false,
        draggable: false,
        modal: true,
        closeOnEscape: true,
        maxHeight: dialogMaxHeight,
        //close: function (e) { $(this).dialog('destroy').remove(); },
        close: function (e) { $(this).dialog('close'); },
        buttons: btns,
        width: 'auto',
        maxWidth: '700px',
        create: function (event, ui) {
            $(this).css({ "min-width": "260px" });
            //$(".table-overflowWrapper").css("width", window.innerWidth - 65);

        },
        open: function (event, ui) {
            $(".ui-dialog-buttonpane").find(':button').focus();
        }
    });
}


//Digit (StyleGuide) Modal
function showHelpModal(data, key, xl) {
    var mdl = $(data);
    var title = mdl.attr("title");
    var content = mdl.html();
    var cta = mdl.attr("close");
    if (!$("#" + key + "-modal").length) {
        $("<aside id='" + key + "-modal' class='dk-modal" + (xl ? "--xl":"") +"' role='dialog' aria-model='true' aria-hidden='true'>" +
            "<header class='dk-modal__title'>" + title + "</header>" +
            "<section class='dk-modal__content'>" + content + "</section>" +
            "<footer class='dk-modal__footer'><span data-modal-dismiss='true' class='dk-btn__primary'>" + cta + "</span></footer>" +
            "<span class='dk-modal__close' data-modal-dismiss='true'></span>" +
            "</aside >").appendTo("body");
        $("#" + key + "-modal a").addClass("dk-link");
        $("#" + key + "-modal span[data-modal-dismiss='true']").on("click", function () { dk.modal("#" + key + "-modal").hide(); });
        dk.modal("#" + key + "-modal").show();
    } else {
        dk.modal("#" + key + "-modal").show();
    }
}

