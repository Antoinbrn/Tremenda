// Used on both shopping cart page and submit page
function createDetailsDataTable() {
    var downloadCSV = $("#DataTableDownloadCSV").val();
    var downloadExcel = $("#DataTableDownloadExcel").val();
    var copyClipboard = $("#DataTableCopyToClipboard").val();
    var copiedText = $("#DataTableTableCopied").val();

    var downloadButtonExcel = {
        exportOptions: {
            columns: [0, 1, 2, 3, 4, 5, 6, 10, 11],
            format: {
                header: function (data) {
                    return data;
                },
                body: function (data, row, column, node) {
                    if (column < 7) {
                        return node.innerText.replace("\r", "").replace("\n", " ").replace(/&lrm;|\u200E/gi, '').trim();
                    }
                    else {
                        if (column === 7) {
                            var cellValue = node.innerText.replace("\r", "").replace("\n", " ").replace(/&lrm;|\u200E/gi, '').trim();
                            return $.isNumeric(cellValue.replace(',', '.')) ? cellValue.replace(',', '.') : cellValue;
                        } else {
                            var cellValue = node.innerText.replace('€', '').replace('HK$', '').replace('AU$', '').replace('NT$', '').replace('$', '').replace(' kr', '')
                                .replace('¥', '').replace('₱', '').replace('£', '').replace('₩', '').replace('kr. ', '').replace('kr ', '').replace('₪', '').trim();
                            return $.isNumeric(cellValue.replace(',', '.')) ? cellValue.replace(',', '.') : cellValue;
                        }
                    }
                }
            }
        },
        className: "exportTableButton",
        filename: function () {
            return $("#BaseFileDownloadName").val();
        }
    };

    var downloadButton = {
        exportOptions: {
            columns: [0, 1, 2, 3, 4, 5, 6, 10, 11],
            format: {
                header: function (data) {
                    return data;
                },
                body: function (data, row, column, node) {
                    return column === 8 ?
                        node.innerText.replace('€', '').replace('HK$', '').replace('AU$', '').replace('NT$', '').replace('$', '').replace(' kr', '')
                            .replace('¥', '').replace('₱', '').replace('£', '').replace('₩', '').replace('kr. ', '').replace('kr ', '').replace('₪', '').replace('₱', '')
                            .replace('฿', '').replace(/&lrm;|\u200E/gi, '').trim() :
                        node.innerText.replace("\r", "").replace("\n", " ").replace(/&lrm;|\u200E/gi,'').trim();
                }
            }
            //charset: 'UTF-16'
        },
        className: "exportTableButton",
        filename: function () {
            return $("#BaseFileDownloadName").val();
        }
    };

    $('.details .dataTable').DataTable({
        "bSort": false,
        "paging": true,
        "bInfo": false,
        "searching": false,
        "autoWidth": false,
        "iDisplayLength": -1,
        "dom": 't<"clear"><"ro-exportTableButtons" B>',
        "buttons": [
            $.extend(true, {}, downloadButton, {
                extend: "copyHtml5",
                text: copyClipboard,
                init: function (dt, node, config) {
                    node.attr("id", "copyTableButton");
                    node.attr("data-autoid", "copyToClipboard");
                }
            }),
            $.extend(true, {}, downloadButton, {
                extend: "csvHtml5",
                charset: "utf-8",
                bom: true,
                text: downloadCSV,
                init: function (dt, node, config) {
                    node.attr("id", "csvDownloadButton");
                    node.attr("data-autoid", "downloadCsv");
                }
            }),
            $.extend(true, {}, downloadButtonExcel, {
                extend: "excelHtml5",
                text: downloadExcel,
                title: '',
                init: function (dt, node, config) {
                    node.attr("id", "excelDownloadButton");
                    node.attr("data-autoid", "downloadExcel");
                }
            })
        ],
        language: {
            buttons: {
                copyTitle: copiedText,
                copySuccess: ''
            }
        }
    });
}

function startSpinner() {
    //check for existing loading div to not make multiple stacked which blocks the page. 
    if (!$("#loadingDiv").length > 0) {
        $("body").append("<div id='loadingDiv' class='ui-widget-overlay'><div id='spinner'></div></div>");
        var divHeight = $(document).height();
        $('#loadingDiv').show().css('height', divHeight);
        $("#content").css("opacity", "0.55");
        var opts = {
            color: '#333'
        };
        var spinner = new Spinner(opts).spin(document.getElementById("spinner"));
    }
}

function stopSpinner() {
    $('#loadingDiv').remove();
    $("#content").css("opacity", "1");
}

