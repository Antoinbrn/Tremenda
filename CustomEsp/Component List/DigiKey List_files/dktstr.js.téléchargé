    },
    checkMaxViews: function(test) {
        return (test.maxViews === "" || test.maxViews === undefined || test.maxViews >= __dktst.dkTestViews.find(o => o.testId === test.Id).views) 
    },
    checkCookies: function(test) {
        return __dktst.getCookie(`dktst_${test.id}_complete`) !== "true" && !["blocked", "skipped"].includes(__dktst.getCookie(`dktst_${test.id}`))
    },
    checkSplit: function(test, timeoutMs = 5000) {
        if (test.startsWith("8")) return true;
        if (__dktst.getCookie("dktst_" + test)) return true;
        __dktst.splitUsers(test);
        const startTime = Date.now();
        return new Promise((resolve) => {
            const interval = setInterval(() => {
                if (__dktst.getCookie("dktst_" + test)) {
                    clearInterval(interval);
                    resolve(true);
                } else if (Date.now() - startTime > timeoutMs) {
                    clearInterval(interval);
                    resolve(false); 
                }
            }, 250);
        });
    },
    checkElement: function(test, timeoutMs = 10000) {
        if (test.element === "" || test.element === undefined) return true;
        const selector = test.element;
        if (!selector || selector === "") return true;
        if (document.querySelector(selector)) return true;

        return new Promise((resolve) => {
            const observer = new MutationObserver(() => {
                if (document.querySelector(selector)) {
                    cleanup();
                    resolve("observed");
                }
            });
    
            const timeout = setTimeout(() => {
                cleanup();
                resolve(false);
            }, timeoutMs);
    
            const cleanup = () => {
                observer.disconnect();
                clearTimeout(timeout);
            };
    
            observer.observe(document.body, {
                childList: true,
                subtree: true
            });
        });
    },
    checkLogin: function(test, loggedInStatus) {
        if (test.loggedIn === "" || test.loggedIn === undefined) return true;
        return String(loggedInStatus) === String(test.loggedIn);
    },
    checkGeoIP: async function(test, geoIpLocation) {
        if (test.geoIP === "" || test.geoIP === undefined) return true;
        if (geoIpLocation === "unknown") return false;
        const geoList = test.geoIP.split(",");
        if (test.geoIP.includes("!")) return !geoList.includes("!" + geoIpLocation);
        return geoList.includes(geoIpLocation);
    },
    processAsyncTests: async function(runTest) {
        const finalResults = await Promise.all(runTest.map(async (test) => {
            const [geo, element, login, split] = await Promise.all([
                __dktstFilter.checkGeoIP(test, geoIpLocation),
                __dktstFilter.checkElement(test),
                __dktstFilter.checkLogin(test, loggedInStatus),
                __dktstFilter.checkSplit(test.id)
            ]);
            const asyncFailures = [];
            if (!geo) asyncFailures.push("geo_fail: "+test.geoIP);
            if (!element) asyncFailures.push("element_fail: "+test.element);
            if (!login) asyncFailures.push("login_fail: expected "+test.loggedIn+" but was "+loggedInStatus);
            if (!split) asyncFailures.push("split_fail: user not assigned to a variant within timeout");
            const isFullyPassed = asyncFailures.length === 0;
            let versionNumber = test.version;
            if (forcedTestID === test.id) {
