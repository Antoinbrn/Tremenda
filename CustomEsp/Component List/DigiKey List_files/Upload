// global Dropzone, dropzone, trigger, serialize, EnableDisableAddToCartButton

$(document).ready(function () {
    Dropzone.autoDiscover = false;
    InitializeTheZone("dropzoneForm");

    // Event delegation for 'Add to Current' button
    $(document).on("click", "#dialog-mapper span[data-button='addToCurrent']", function () {
        dk.modal("#dialog-mapper").hide();
        $("#hdnNewCart").val("false");

        const formData = $("#theFORM");
        formatFileContents(formData).then(function (fileContents) {
            if (fileContents === null) {
                genericErrorModal();
            } else {
                addFileContentsToCart(fileContents);
            }
            $("#btnRemove").trigger("click");
        });
    });

    // Event delegation for 'Add to New' button
    $(document).on("click", "#dialog-mapper span[data-button='addToNew']", function () {
        dk.modal("#dialog-mapper").hide();
        $("#hdnNewCart").val("true");

        const formData = $("#theFORM");
        formatFileContents(formData).then(function (fileContents) {
            if (fileContents === null) {
                genericErrorModal();
            } else {
                addFileContentsToNewCart(fileContents);
            }
        });
        $("#btnRemove").trigger("click");
    });

    // Event delegation for modal dismiss
    $(document).on("click", "#dialog-mapper *[data-modal-dismiss='true'], .mapper-active", function () {
        dk.modal("#dialog-mapper").hide();
        $("#auto-modal-mask").removeClass("mapper-active");
        $("#mapper-content").html("");
        $("#btnRemove").trigger("click");
    });

    // Event delegation for bad mapper dialog dismiss
    $(document).on("click", "#dialog-mapper-bad-map *[data-modal-dismiss='true'], .mapper-active", function () {
        dk.modal("#dialog-mapper-bad-map").hide();
        $("#auto-modal-mask").removeClass("mapper-active");
        $("#bad-mapper-content").html("");
        $("#btnRemove").trigger("click");
    });
});

function formatFileContents(formData) {
    return $.ajax({
        cache: false,
        type: "POST",
        global: false,
        url: "upload/Upload/FormatFileContentsAsCsvAsync",
        data: formData.serialize()
    }).then(function (result) {
        if (result.DidSucceed) {
            return result.OrderDetails;
        } else {
            return null;
        }
    }, function () {
        return null;
    });
}

function addFileContentsToCart(formattedFileContents) {
    const addedFrom = "importParts";
    $.ajax({
        url: "/ordering/shoppingcart/shoppingcart/ImportParts",
        type: "POST",
        data: { parts: formattedFileContents },
        success: function (data) {
            const returnObj = { successesExist: false, successIndices: "", failuresExist: false, errors: "", warnings: "" };
            handleMultiplePartErrorOptions(data, addedFrom, returnObj);
            return;
        },
        error: function (xhr, textStatus, errorThrown) {
            genericErrorModal();
        }
    });
}

function handleMultiplePartErrorOptions(data, addedFrom, returnObj) {
    if (data.response.BaseSuccess) {
        processAddPartsResponse(data.response, addedFrom, returnObj);
        refreshPage(addedFrom, returnObj);
        $('.AddPart').val('');
        $("#textImportTextArea").val('');
    }
    if (data.response.BaseSuccess !== true) {
        genericErrorModal();
        return;
    }
    // Display error partial view if when exits
    if (data.errorPartialView) {
        $('#PartErrorTable tbody').append(data.errorPartialView);
        getPartResultsAndCallAssignIndexToPartErrorRows(data);
        $('#PartErrorContainer').removeAttr('hidden');
    }
}

function addFileContentsToNewCart(formattedFileContents) {
    const addedFrom = "importParts";
    $.ajax({
        url: "/ordering/shoppingcart/shoppingcart/ImportParts",
        type: "POST",
        data: { parts: formattedFileContents, makeNewCart: true },
        success: function (data) {
            ClearCachedPartErrorData();
            if (data.response.BaseSuccess) {
                let returnObj = { successesExist: false, successIndices: "", failuresExist: false, errors: "", warnings: "" };
                processAddPartsResponse(data.response, addedFrom, returnObj);
                refreshPage(addedFrom, returnObj)
            }

            if (data.response.BaseSuccess !== true) {
                genericErrorModal();
                return;
            }

            //since a new cart was made empty the error table and hide it
            $('#PartErrorTable tbody').empty();
            $('#PartErrorContainer').attr('hidden', '');
            // Display error partial view if present
            if (data.errorPartialView) {  
                $('#PartErrorTable tbody').append(data.errorPartialView);
                // This should always be creating a new cart and so it should only ever check for data.response.DetaillResponses.partResults
                const partResults = (data.response.DetailResponses && data.response.DetailResponses.partResults);
                if (partResults) {
                    AssignIndexToPartErrorRows(partResults);
                }
                AssignIndexToPartErrorRows(data.response.DetailResponses.partResults);
                $('#PartErrorContainer').removeAttr('hidden');
            }
        },
        error: function (xhr, textStatus, errorThrown) {
            genericErrorModal();
        }
    });
}

function showMapperDialog() {
    dk.modal("#dialog-mapper").show();
    $("#auto-modal-mask").addClass("mapper-active");
}

function showBadMapperDialog() {
    dk.modal("#dialog-mapper-bad-map").show();
    $("#auto-modal-mask").addClass("mapper-active");
}

function InitializeTheZone(dropzoneFormId) {

    var spinner; // Need this in full scope of the function

    $(`#${dropzoneFormId}`).dropzone({
        createImageThumbnails: false,
        maxFiles: 1,
        fallback: function () {
            $(`#${dropzoneFormId}`).hide();
        },
        init: function () {
            this.on("complete", function (data) {
                if (data.xhr !== undefined && $(data.xhr.responseText).find("#UploadMapperPartialPage").length > 0) {
                    this.removeAllFiles();
                    spinner.stop();
                    $("#mapper-content").html(data.xhr.responseText);
                    showMapperDialog();
                    EnableDisableAddToCartButton();
                } else {
                    spinner.stop();
                    if (data.xhr !== undefined && $(data.xhr.responseText).find("#InvalidUploadMapperPartialPage").length > 0) {
                        $("#bad-mapper-content").append("<p>" + '@Html.GetPhrase("upload-bad-filetype")' + "</p>");
                    }
                    else {
                        $("#bad-mapper-content").append("<p>" + '@Html.GetPhrase("were-sorry-please-try-again-later")' + "</p>");
                    }
                    showBadMapperDialog();
                }
            });

            this.on("addedfile", function (file) {
                // create remove button
                const removeButton = Dropzone.createElement("<button id='btnRemove'>Remove</button>");

                // listen for click
                removeButton.addEventListener("click", function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    this.removeFile(file);
                });

                file.previewElement.appendChild(removeButton);
                $(file.previewElement).hide();

                // Clear out the mapper div, pop it as a new dialog with no buttons
                $("#mapper-content").html("");

                // Throw a spinner into the dialog, sometimes it takes a while to post and read in large files
                spinner = new Spinner().spin(document.getElementById("mapper-content"));
            });
        }
    });
};
